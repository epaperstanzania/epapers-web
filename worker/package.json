{
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "name": "@epapers/worker",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint index.ts lambda.mjs --max-warnings=0",
