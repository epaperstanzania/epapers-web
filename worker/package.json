{
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "name": "@epapers/worker",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint index.ts cloudflare.ts cloudflare.config.ts vite.config.ts --max-warnings=0",
    "start": "node --conditions=react-server --import tsx index.ts",
    "dev:cloudflare": "cf dev",
    "types:cloudflare": "cf workers types",
    "deploy:cloudflare": "cf deploy",
    "deploy:cloudflare:backup": "cf deploy --mode backup"
  },
  "dependencies": {
    "@epapers/server": "workspace:*",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "cf": "0.15.0",
    "vite": "8.3.5"
  }
}
