# Server-only. Replace placeholders in your deployment secret manager. Never commit real values.
# The origins below are for local development only. Do not copy them into Vercel Production.
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3000
PORTAL_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_DOMAIN=
TRUST_PROXY=false
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
REFRESH_TOKEN_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
IP_HASH_SALT=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_INCOMING_BUCKET=epapers-incoming
R2_PUBLISHED_BUCKET=epapers-published
EMAIL_PROVIDER=smtp
EMAIL_FROM=EPapers <no-reply@epapers.co.tz>
SMTP_HOST=REPLACE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=EPapers <no-reply@epapers.co.tz>
SMTP_DAILY_LIMIT=450
LOG_LEVEL=info
MAX_UPLOAD_BYTES=15728640
DAILY_UPLOAD_QUOTA=20
# Public build-time values; never place secrets here. These localhost values are
# for local development. In Vercel, set the Production values shown below in
# every portal project (or use your four configured custom domains consistently).
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CONTRIBUTOR_ORIGIN=http://localhost:3002
NEXT_PUBLIC_LECTURER_ORIGIN=http://localhost:3003
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3004

# Same-origin API proxy and secure portal sign-in, including on *.vercel.app.
NEXT_PUBLIC_AUTH_MODE=proxy

# Vercel Production profile for deployment/portals.json. The Vercel Next.js
# configs set these public values automatically; do not override them in Vercel:
# NEXT_PUBLIC_API_BASE_URL=/api/v1
# NEXT_PUBLIC_AUTH_MODE=proxy
# NEXT_PUBLIC_WEB_ORIGIN=https://epapertz.vercel.app
# NEXT_PUBLIC_CONTRIBUTOR_ORIGIN=https://epapertz-contributor.vercel.app
# NEXT_PUBLIC_LECTURER_ORIGIN=https://epapertz-lecturer.vercel.app
# NEXT_PUBLIC_ADMIN_ORIGIN=https://epapertz-admin.vercel.app
#
# Vercel server code also normalizes these deployment values automatically.
# Supply actual backend secrets in the public project's Production settings;
# never copy placeholder values or VERCEL_OIDC_TOKEN:
# APP_ORIGIN=https://epapertz.vercel.app
# API_ORIGIN=https://epapertz.vercel.app
# PORTAL_ORIGINS=https://epapertz.vercel.app,https://epapertz-contributor.vercel.app,https://epapertz-lecturer.vercel.app,https://epapertz-admin.vercel.app
# COOKIE_DOMAIN= (Vercel always uses host-only cookies)
# TRUST_PROXY=false
