# Server-only. Replace placeholders in your deployment secret manager. Never commit real values.
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3000
PORTAL_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_DOMAIN=
EPAPERS_WORKER_TOKEN=replace-with-a-shared-random-token
# Application
NODE_ENV=development
PORT=3000

# CockroachDB connection string (use sslmode=verify-full in production)
DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full

# Cloudflare R2. Use separate private buckets for incoming and published PDFs.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_INCOMING_BUCKET=epapers-incoming
R2_PUBLISHED_BUCKET=epapers-published
R2_PUBLIC_BASE_URL=

# Generate independent random values with at least 32 bytes of entropy.
JWT_ACCESS_SECRET=replace-with-at-least-32-byte-random-secret
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-byte-random-secret
IP_HASH_SALT=replace-with-at-least-32-byte-random-secret

# Email: smtp or resend. SMTP is configured for Google SMTP by default.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Epapers <no-reply@example.com>
RESEND_API_KEY=

# Cloudflare Turnstile

# Optional operational settings
MAX_UPLOAD_BYTES=15728640
SIGNED_URL_TTL_SECONDS=600
LOG_LEVEL=info


# Encryption for auth email outbox and admin TOTP secrets
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

TEST_DATABASE_URL=postgresql://<user>:<password>@<host>:26257/<test-database>?sslmode=verify-full

EMAIL_FROM=Epapers <no-reply@example.com>

# Public build-time values; never place secrets here.
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CONTRIBUTOR_ORIGIN=http://localhost:3002
NEXT_PUBLIC_LECTURER_ORIGIN=http://localhost:3003
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3004

# Same-origin API proxy and secure portal sign-in, including on *.vercel.app.
NEXT_PUBLIC_AUTH_MODE=proxy
