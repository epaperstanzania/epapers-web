        "https://epapertz-admin.vercel.app",
        "https://epapers.co.tz",
        "https://www.epapers.co.tz",
        "https://contributor.epapers.co.tz",
        "https://www.contributor.epapers.co.tz",
        "https://lecturer.epapers.co.tz",
        "https://www.lecturer.epapers.co.tz",
        "https://console.epapers.co.tz",
        "https://www.console.epapers.co.tz",
        "http://localhost:3000",
        "http://localhost:3002",
        "http://localhost:3003",
        "http://localhost:3004"
