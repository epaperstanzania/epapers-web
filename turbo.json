{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs"
  ],
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_*"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "APP_ORIGIN",
    "API_ORIGIN",
    "PORTAL_ORIGINS",
    "COOKIE_DOMAIN",
    "TRUST_PROXY",
    "DATA_ENCRYPTION_KEY",
    "JWT_ACCESS_SECRET",
    "REFRESH_TOKEN_PEPPER",
    "IP_HASH_SALT",
    "R2_*",
    "EMAIL_*",
    "SMTP_*",
    "RESEND_API_KEY",
    "LOG_LEVEL",
    "MAX_UPLOAD_BYTES",
    "DAILY_UPLOAD_QUOTA",
    "TEST_DATABASE_URL"
  ],
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build",
        "@epapers/database#generate"
      ],
      "cache": false,
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "@epapers/database#generate"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "@epapers/database#generate"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build",
        "@epapers/database#generate"
      ],
      "cache": false,
      "outputs": []
    }
  }
}
