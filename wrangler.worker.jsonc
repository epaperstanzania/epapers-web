{
  "$schema": "./worker/node_modules/wrangler/config-schema.json",
  "name": "epapers-background-worker",
  "main": "worker/cloudflare.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "containers": [
    {
      "class_name": "EpapersWorkerContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "worker": {
          "dockerfile": "./Dockerfile.cloudflare-worker"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EPAPERS_WORKER",
        "class_name": "EpapersWorkerContainer"
      }
    ]
  },
  "exports": {
    "EpapersWorkerContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "NODE_ENV": "production",
    "APP_ORIGIN": "https://epapertz.vercel.app",
    "API_ORIGIN": "https://epapertz.vercel.app",
    "PORTAL_ORIGINS": "https://epapertz.vercel.app,https://epapertz-contributor.vercel.app,https://epapertz-lecturer.vercel.app,https://epapertz-admin.vercel.app",
    "COOKIE_DOMAIN": "",
    "TRUST_PROXY": "false",
    "R2_INCOMING_BUCKET": "epapers-incoming",
    "R2_PUBLISHED_BUCKET": "epapers-published",
    "R2_PUBLIC_BASE_URL": "",
    "EMAIL_PROVIDER": "smtp",
    "EMAIL_FROM": "EPapers <no-reply@epapers.co.tz>",
    "SMTP_DAILY_LIMIT": "450",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "false",
    "SMTP_FROM": "EPapers <no-reply@epapers.co.tz>",
    "LOG_LEVEL": "info"
  }
}
